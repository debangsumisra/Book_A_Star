# Copy this file to .env and fill in the real values.
# Find both values in your Supabase dashboard:
#   Project Settings -> Data API  (URL)
#   Project Settings -> API Keys  (anon / publishable key)
#
# Vite only exposes variables that start with VITE_ to the browser.
# That is intentional: these two values are PUBLIC and safe to ship.
# Your data is protected by Row Level Security in the database, NOT by hiding these.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER put the service_role key in this file or any VITE_ variable.
# It bypasses Row Level Security. It belongs only on a server, never in the browser.
